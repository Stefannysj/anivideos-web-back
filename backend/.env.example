# PostgreSQL local (Docker Compose)
POSTGRES_DB=anivideos
POSTGRES_USER=anivideos
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://anivideos:change-me-local-only@127.0.0.1:5432/anivideos
TEST_DATABASE_URL=postgresql://anivideos:change-me-local-only@127.0.0.1:5432/anivideos_test

# App
ANIVIDEOS_ENV=development
ANIVIDEOS_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
ANIVIDEOS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ANIVIDEOS_COOKIE_SECURE=0
ANIVIDEOS_ENABLE_DOCS=1

# External catalog providers
# AniList is public and does not require a key.
TMDB_READ_TOKEN=
TMDB_REGION=PE
